# CMS 管理员账号（首次启动使用，务必修改）
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=change-me-to-a-strong-password

# 本地开发数据库路径（相对于项目根目录，与启动目录无关）
CMS_DB_PATH=apps/api/data/cms.sqlite

# 数据库驱动（可选）：
#   不设置 = 自动（Node >= 22.5 用 node:sqlite，否则 sql.js）
#   native = 强制 node:sqlite
#   sqljs  = 强制 sql.js（WASM）
# 说明：EdgeOne Cloud Functions 运行时为 Node 20（无 node:sqlite），
#       会自动走 sql.js，无需手动设置。
CMS_DB_DRIVER=

# 数据库云端持久化模式：
#   不设置或留空 = 本地文件持久化（开发环境）
#   cos          = 数据库文件托管在腾讯云 COS（EdgeOne Cloud Functions 部署环境）
# 说明：Cloud Functions 文件系统不保证长期持久，部署时必须设为 cos。
#       此时需同时提供下面的 COS_* 环境变量（启动早期数据库为空，
#       无法从 settings 表读取 COS 配置，只能依赖环境变量）。
CMS_DB_REMOTE=

# COS 凭据（仅在 CMS_DB_REMOTE=cos 时必需，用于数据库托管）
# 与「系统管理 → 设置 → 图片设置」中配置的 COS 可以是同一个 Bucket
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
COS_DOMAIN=
COS_FOLDER=

# 无法从仓库 package.json 读取时展示的 Hexo 版本号
CMS_HEXO_VERSION=7.x

# 注意：GitHub Token、COS 密钥等敏感配置不要放在这里，
# 请登录 CMS 后在「系统管理 → 设置」中填写（会加密存放在 CMS 的 SQLite）。
