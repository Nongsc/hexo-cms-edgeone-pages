# CMS 管理员账号（首次启动使用，务必修改）
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=change-me-to-a-strong-password

# 本地开发数据库路径（相对于项目根目录，与启动目录无关）
CMS_DB_PATH=apps/api/data/cms.sqlite

# 无法从仓库 package.json 读取时展示的 Hexo 版本号
CMS_HEXO_VERSION=7.x

# 注意：GitHub Token、COS 密钥等敏感配置不要放在这里，
# 请登录 CMS 后在「系统管理 → 设置」中填写（会加密存放在 CMS 的 SQLite）。
