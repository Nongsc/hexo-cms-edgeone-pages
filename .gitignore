# 依赖
node_modules
.pnpm-store

# 构建产物
dist
.output
.turbo
.vite
dev-dist
apps/api/dist-edge
*.tsbuildinfo

# 注意：cloud-functions/ 是 EdgeOne 的函数入口目录，必须提交到仓库。
# EdgeOne 在代码仓库里扫描该目录生成函数路由；若被 gitignore，
# 部署时会出现「No server-handler detected」，/api/* 全被 SPA 回退拦截。

# 日志
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# 环境变量（含密钥，切勿提交）
.env
.env.*
!.env.example

# 本地 SQLite 数据（含 GitHub Token / COS 密钥 / 管理员密码，切勿提交）
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
apps/api/data/*.sqlite
apps/api/data/*.sqlite-journal
apps/api/data/*.sqlite-wal
apps/api/data/*.sqlite-shm
**/data/*.sqlite*

# 工具产生的临时目录
.acl-recovery

# 编辑器
.idea
.vscode/*
!.vscode/extensions.json

# 测试覆盖
coverage
