{
  "name": "hexo-pro-cms",
  "framework": "vite",
  "buildCommand": "pnpm install --no-frozen-lockfile && pnpm --filter @hexo-pro/api build:edge && pnpm --filter @hexo-pro/web build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "directory": "apps/api/dist-edge"
  },
  "routes": [
    {
      "src": "/api/*",
      "dest": "/apps/api/dist-edge/index.js",
      "continue": false
    },
    {
      "src": "/*",
      "dest": "/index.html",
      "continue": false
    }
  ],
  "headers": [
    {
      "source": "/assets/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
