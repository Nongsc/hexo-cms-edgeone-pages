{
  "name": "hexo-pro-cms",
  "framework": "vite",
  "nodeVersion": "22.11.0",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @hexo-pro/api build:edge && pnpm --filter @hexo-pro/web build",
  "outputDirectory": "apps/web/dist",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
