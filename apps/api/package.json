    "test": "vitest run"
  },
  "dependencies": {
    "@hexo-pro/core": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
