{
  "name": "@hexo-pro/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:edge": "tsx build-edge.ts",
    "start": "node dist/server.js",
